_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata
.lighthouseci/
# Ignore folders generated by Bundler
.bundle/
.DS_Store
# Python working environments and bytecode under design/ are local, not shared.
__pycache__/
*.pyc
.venv/

# Dojo's build-input snapshot for the vendored host release. Deliberately not
# committed: the site serves the artifact and the pin names the exact source
# commit (_data/hatch.yml); the snapshot stays where the producer writes it, in
# the dojo checkout. Keeping it out costs the release gates their per-source
# re-hash from a clone — see design/hatch.org.
assets/lib/hatch/sources/

# pi's session state and this machine's sandbox permissions: local, not shared.
.pi/

# The still encoder (sharp) is installed from package-lock.json. Not committed.
node_modules/

# Dormant runtime and prototypes are local-only, not maintained test inputs.
_includes/home/fourth-turn.html
assets/css/components/fourth-turn.css
assets/js/home/fourth-turn.mjs
assets/js/home/fourth-turn/
assets/js/home/halfway/
assets/js/home/helios-interval.js
assets/js/home/helios-plang-tokens.js
assets/js/home/kindle.mjs
assets/js/home/paperlang/

# The design workbench's raw material: the video masters clips are minted from
# (design/assets) and the superseded hifi/prototype pages they were studied in
# (iterations, cutouts, prior, rapiditer, stage). ~155MB, and no build input
# reads them — what the gates read is design/*.mjs, design/probe,
# design/fixtures and the doc set, which are committed. Re-minting a still
# or clip needs the masters back from the producer's
# archive, the same trade as the hatch sources above.
design/assets/
design/iterations/*
design/cutouts/
design/prior/
design/rapiditer/
design/stage/
